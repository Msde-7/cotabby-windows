<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>Cotabby.App</RootNamespace>
    <AssemblyName>Cotabby</AssemblyName>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <ApplicationIcon>Assets\Cotabby.ico</ApplicationIcon>
    <Version>0.7.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\CotabbyLogo.png" />
    <Resource Include="Assets\Cotabby.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="H.NotifyIcon.Wpf" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cotabby.Core\Cotabby.Core.csproj" />
    <ProjectReference Include="..\Cotabby.Inference\Cotabby.Inference.csproj" />
    <ProjectReference Include="..\Cotabby.Win32\Cotabby.Win32.csproj" />
  </ItemGroup>

</Project>
