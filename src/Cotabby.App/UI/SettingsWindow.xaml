<Window x:Class="Cotabby.App.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings — General"
        Width="860"
        Height="600"
        MinWidth="720"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBg}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <!-- Theme brushes: dark defaults; ApplyTheme() swaps values at runtime so
             every DynamicResource repaints without re-templating. -->
        <SolidColorBrush x:Key="WindowBg" Color="#1F1F1F" />
        <SolidColorBrush x:Key="SidebarBg" Color="#252525" />
        <SolidColorBrush x:Key="CardBg" Color="#2A2A2A" />
        <SolidColorBrush x:Key="CardBorder" Color="#3D3D3D" />
        <SolidColorBrush x:Key="TextPrimary" Color="#E8E8E8" />
        <SolidColorBrush x:Key="TextSecondary" Color="#9A9A9A" />
        <SolidColorBrush x:Key="InputBg" Color="#333333" />
        <SolidColorBrush x:Key="KeycapBg" Color="#3A3A3A" />
        <SolidColorBrush x:Key="TrackOff" Color="#4A4A4A" />
        <SolidColorBrush x:Key="HoverBg" Color="#12FFFFFF" />

        <!-- Fixed accents shared by both themes. -->
        <SolidColorBrush x:Key="AccentBrush" Color="#007AFF" />
        <SolidColorBrush x:Key="AccentTint" Color="#26007AFF" />
        <SolidColorBrush x:Key="GreenBrush" Color="#22C55E" />
        <SolidColorBrush x:Key="OrangeBrush" Color="#F97316" />

        <Style x:Key="CardHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="2,0,0,7" />
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Mono" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,0,20" />
        </Style>
        <Style x:Key="RowSep" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{DynamicResource CardBorder}" />
        </Style>
        <Style x:Key="SettingRow" TargetType="Grid">
            <Setter Property="MinHeight" Value="44" />
        </Style>

        <!-- macOS-style switch: CheckBox retemplated as a pill track + knob. -->
        <Style x:Key="Toggle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Track" Width="38" Height="22" CornerRadius="11"
                                Background="{DynamicResource TrackOff}">
                            <Ellipse x:Name="Knob" Width="16" Height="16" Fill="White"
                                     HorizontalAlignment="Left" Margin="3,0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Background" Value="{DynamicResource KeycapBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AccentBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="Input" TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Background" Value="{DynamicResource InputBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1">
                            <Grid>
                                <!-- Placeholder: Tag doubles as hint text so one style
                                     serves every box without extra attached properties. -->
                                <TextBlock x:Name="Hint" Text="{TemplateBinding Tag}"
                                           Margin="{TemplateBinding Padding}" FontSize="13"
                                           Foreground="{DynamicResource TextSecondary}"
                                           Visibility="Collapsed" IsHitTestVisible="False" />
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Hint" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ComboItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" CornerRadius="5" Padding="{TemplateBinding Padding}"
                                Background="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentTint}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Combo" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinWidth" Value="130" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource ComboItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border CornerRadius="6"
                                                Background="{DynamicResource KeycapBg}"
                                                BorderBrush="{DynamicResource CardBorder}"
                                                BorderThickness="1" />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Margin="10,5,26,5" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              VerticalAlignment="Center" HorizontalAlignment="Left" />
                            <TextBlock Text="&#xE70D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Margin="0,0,10,0" Foreground="{DynamicResource TextSecondary}"
                                       IsHitTestVisible="False" />
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Margin="0,4,0,0" CornerRadius="8"
                                        Background="{DynamicResource CardBg}"
                                        BorderBrush="{DynamicResource CardBorder}"
                                        BorderThickness="1" Padding="4"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="220">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernSlider" TargetType="Slider">
            <Setter Property="Height" Value="20" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="4" CornerRadius="2" Background="{DynamicResource TrackOff}" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2"
                                                        Background="{StaticResource AccentBrush}" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="16" Height="16">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="White" Stroke="#66000000" StrokeThickness="0.5" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Bar" TargetType="ProgressBar">
            <Setter Property="Height" Value="4" />
            <Setter Property="Background" Value="{DynamicResource TrackOff}" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" CornerRadius="2"
                                    Background="{TemplateBinding Background}" />
                            <Border x:Name="PART_Indicator" CornerRadius="2"
                                    Background="{TemplateBinding Foreground}"
                                    HorizontalAlignment="Left" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RadioRow" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Grid Width="18" Height="18" VerticalAlignment="Center">
                                <Ellipse x:Name="Outer" Stroke="{DynamicResource TextSecondary}"
                                         StrokeThickness="1.5" />
                                <Ellipse x:Name="Dot" Width="7" Height="7" Fill="White"
                                         Visibility="Collapsed" />
                            </Grid>
                            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Outer" Property="Fill" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Outer" Property="Stroke" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Segment" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="5" Padding="14,4" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Keycap" TargetType="Border">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="{DynamicResource KeycapBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="KeycapText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="NavGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Width" Value="22" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        </Style>
        <Style x:Key="NavLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="NavItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="6" Margin="8,1" Padding="10,7"
                                Background="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBg}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentTint}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============================ SIDEBAR ============================ -->
        <Border Background="{DynamicResource SidebarBg}"
                BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,1,0">
            <ListBox x:Name="NavList" Background="Transparent" BorderThickness="0"
                     Margin="0,10,0,10" SelectionChanged="OnNavChanged"
                     ItemContainerStyle="{StaticResource NavItem}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource NavGlyph}" Text="&#xE713;" />
                        <TextBlock Style="{StaticResource NavLabel}" Text="General" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource NavGlyph}" Text="&#xE950;" />
                        <TextBlock Style="{StaticResource NavLabel}" Text="Engine &amp; Model" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource NavGlyph}" Text="&#xE70F;" />
                        <TextBlock Style="{StaticResource NavLabel}" Text="Writing" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource NavGlyph}" Text="&#xE765;" />
                        <TextBlock Style="{StaticResource NavLabel}" Text="Shortcuts" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource NavGlyph}" Text="&#xE71D;" />
                        <TextBlock Style="{StaticResource NavLabel}" Text="Apps" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource NavGlyph}" Text="&#xE9E9;" />
                        <TextBlock Style="{StaticResource NavLabel}" Text="Advanced" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource NavGlyph}" Text="&#xE946;" />
                        <TextBlock Style="{StaticResource NavLabel}" Text="About" />
                    </StackPanel>
                </ListBoxItem>
            </ListBox>
        </Border>

        <!-- ============================ DETAIL ============================ -->
        <Grid Grid.Column="1">

            <!-- ======================= GENERAL ======================= -->
            <ScrollViewer x:Name="GeneralPane" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Margin="28,22,28,28" MaxWidth="660" HorizontalAlignment="Left">
                    <TextBlock Style="{StaticResource CardHeader}" Text="Status" />
                    <Border Style="{StaticResource Card}" Padding="14,3">
                        <StackPanel>
                            <Grid Style="{StaticResource SettingRow}">
                                <TextBlock Style="{StaticResource RowLabel}" Text="Enable Globally" />
                                <CheckBox x:Name="EnableToggle" Style="{StaticResource Toggle}"
                                          Checked="OnGeneralToggle" Unchecked="OnGeneralToggle" />
                            </Grid>
                            <Border Style="{StaticResource RowSep}" />
                            <Grid Style="{StaticResource SettingRow}">
                                <TextBlock Style="{StaticResource RowLabel}" Text="Open at Login" />
                                <CheckBox x:Name="LoginToggle" Style="{StaticResource Toggle}"
                                          Checked="OnGeneralToggle" Unchecked="OnGeneralToggle" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource CardHeader}" Text="Behavior" />
                    <Border Style="{StaticResource Card}" Padding="14,3">
                        <StackPanel>
                            <Grid Style="{StaticResource SettingRow}">
                                <TextBlock Style="{StaticResource RowLabel}" Text="Allow Multi-line Suggestions" />
                                <CheckBox x:Name="MultiLineToggle" Style="{StaticResource Toggle}"
                                          Checked="OnGeneralToggle" Unchecked="OnGeneralToggle" />
                            </Grid>
                            <Border Style="{StaticResource RowSep}" />
                            <Grid Style="{StaticResource SettingRow}">
                                <TextBlock Style="{StaticResource RowLabel}" Text="Accept Punctuation With Word" />
                                <CheckBox x:Name="PunctToggle" Style="{StaticResource Toggle}"
                                          Checked="OnGeneralToggle" Unchecked="OnGeneralToggle" />
                            </Grid>
                            <Border Style="{StaticResource RowSep}" />
                            <Grid Style="{StaticResource SettingRow}">
                                <TextBlock Style="{StaticResource RowLabel}" Text="Inline Emoji Picker" />
                                <CheckBox x:Name="EmojiToggle" Style="{StaticResource Toggle}"
                                          Checked="OnGeneralToggle" Unchecked="OnGeneralToggle" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource CardHeader}" Text="Display" />
                    <Border Style="{StaticResource Card}" Padding="14,3">
                        <Grid Style="{StaticResource SettingRow}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource RowLabel}" Text="Show" />
                                <Border Style="{StaticResource Keycap}" Margin="6,0" Padding="7,2">
                                    <TextBlock Style="{StaticResource KeycapText}" FontSize="11" Text="Tab" />
                                </Border>
                                <TextBlock Style="{StaticResource RowLabel}" Text="Key Hint" />
                            </StackPanel>
                            <CheckBox x:Name="HintToggle" Style="{StaticResource Toggle}"
                                      Checked="OnGeneralToggle" Unchecked="OnGeneralToggle" />
                        </Grid>
                    </Border>

                    <TextBlock Style="{StaticResource CardHeader}" Text="Appearance" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource RowLabel}" Text="Ghost Text Color" />
                            <StackPanel x:Name="SwatchPanel" Orientation="Horizontal" Margin="0,10,0,12" />
                            <Border Style="{StaticResource RowSep}" />
                            <Grid Style="{StaticResource SettingRow}" Margin="0,4,0,0">
                                <TextBlock Style="{StaticResource RowLabel}" Text="Ghost Text Opacity" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Slider x:Name="OpacitySlider" Style="{StaticResource ModernSlider}"
                                            Width="180" Minimum="0.3" Maximum="1.0"
                                            SmallChange="0.1" LargeChange="0.1" TickFrequency="0.1"
                                            IsSnapToTickEnabled="True" ValueChanged="OnOpacityChanged" />
                                    <TextBlock x:Name="OpacityLabel" Style="{StaticResource Mono}"
                                               Width="42" TextAlignment="Right" VerticalAlignment="Center"
                                               Margin="8,0,0,0" Text="100%" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ==================== ENGINE & MODEL ==================== -->
            <ScrollViewer x:Name="EnginePane" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Margin="28,22,28,28" MaxWidth="660" HorizontalAlignment="Left">
                    <TextBlock Style="{StaticResource CardHeader}" Text="Status" />
                    <Border Style="{StaticResource Card}" Padding="14,3">
                        <Grid Style="{StaticResource SettingRow}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="Runtime" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <Ellipse x:Name="RuntimeDot" Width="9" Height="9" Margin="0,1,7,0"
                                         VerticalAlignment="Center" Fill="{StaticResource OrangeBrush}" />
                                <TextBlock x:Name="RuntimeStatusText" Style="{StaticResource RowLabel}"
                                           Foreground="{DynamicResource TextSecondary}" Text="Not loaded" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock Style="{StaticResource CardHeader}" Text="Models" />
                    <Border Style="{StaticResource Card}" Padding="14,4">
                        <StackPanel x:Name="ModelsPanel" />
                    </Border>

                    <TextBlock Style="{StaticResource CardHeader}" Text="Folder" />
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ModelsFolderText" Style="{StaticResource Mono}"
                                       Foreground="{DynamicResource TextSecondary}"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                       Margin="0,0,12,0" />
                            <Button Grid.Column="1" Style="{StaticResource Btn}" Content="Open Folder"
                                    Click="OnOpenModelsFolder" />
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ======================== WRITING ======================== -->
            <ScrollViewer x:Name="WritingPane" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Margin="28,22,28,28" MaxWidth="660" HorizontalAlignment="Left">
                    <TextBlock Style="{StaticResource CardHeader}" Text="Length" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel x:Name="LengthPanel" Margin="0,-2" />
                    </Border>

                    <TextBlock Style="{StaticResource CardHeader}" Text="Profile" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource RowLabel}" Text="Name" />
                            <TextBox x:Name="NameBox" Style="{StaticResource Input}"
                                     Tag="What should Cotabby call you?" Margin="0,8,0,2"
                                     MaxWidth="340" HorizontalAlignment="Left" MinWidth="340"
                                     TextChanged="OnNameChanged" LostFocus="OnNameLostFocus" />
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource CardHeader}" Text="Languages" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <WrapPanel x:Name="LanguageChips" Margin="0,0,0,6" />
                            <Grid Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MaxWidth="260" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="LanguageBox" Style="{StaticResource Input}"
                                         Tag="Add a language…" KeyDown="OnLanguageBoxKeyDown" />
                                <Button Grid.Column="1" Style="{StaticResource Btn}" Content="Add"
                                        Margin="8,0,0,0" Click="OnAddLanguage" />
                            </Grid>
                            <WrapPanel x:Name="LanguageSuggestions" Margin="0,12,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ======================= SHORTCUTS ======================= -->
            <ScrollViewer x:Name="ShortcutsPane" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Margin="28,22,28,28" MaxWidth="660" HorizontalAlignment="Left">
                    <TextBlock Style="{StaticResource CardHeader}" Text="Mode" />
                    <Border Style="{StaticResource Card}" Padding="14,3">
                        <Grid Style="{StaticResource SettingRow}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="Acceptance Mode" />
                            <Border CornerRadius="7" Background="{DynamicResource InputBg}" Padding="2"
                                    HorizontalAlignment="Right" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="ModeWord" Style="{StaticResource Segment}"
                                                 GroupName="AcceptMode" Content="Word"
                                                 Checked="OnModeChanged" />
                                    <RadioButton x:Name="ModePhrase" Style="{StaticResource Segment}"
                                                 GroupName="AcceptMode" Content="Phrase"
                                                 Checked="OnModeChanged" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <TextBlock Style="{StaticResource CardHeader}" Text="Keys" />
                    <Border Style="{StaticResource Card}" Padding="14,3">
                        <StackPanel>
                            <Grid Style="{StaticResource SettingRow}">
                                <TextBlock Style="{StaticResource RowLabel}" Text="Accept Word" />
                                <Border Style="{StaticResource Keycap}" HorizontalAlignment="Right">
                                    <TextBlock Style="{StaticResource KeycapText}" Text="Tab" />
                                </Border>
                            </Grid>
                            <Border Style="{StaticResource RowSep}" />
                            <Grid Style="{StaticResource SettingRow}">
                                <TextBlock Style="{StaticResource RowLabel}" Text="Accept Entire Suggestion" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                    <Border Style="{StaticResource Keycap}" MinWidth="30">
                                        <TextBlock x:Name="AcceptKeycapText" Style="{StaticResource KeycapText}"
                                                   TextAlignment="Center" Text="`" />
                                    </Border>
                                    <ComboBox x:Name="AcceptKeyCombo" Style="{StaticResource Combo}"
                                              Margin="10,0,0,0" SelectionChanged="OnAcceptKeyChanged" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ========================== APPS ========================== -->
            <ScrollViewer x:Name="AppsPane" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Margin="28,22,28,28" MaxWidth="660" HorizontalAlignment="Left">
                    <TextBlock Style="{StaticResource CardHeader}" Text="Disabled Apps" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Caption}"
                                       Text="Cotabby stays quiet in these apps." />
                            <StackPanel x:Name="BlockedAppsPanel" Margin="0,8,0,0" />
                            <Border Style="{StaticResource RowSep}" Margin="0,8,0,0" />
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MaxWidth="260" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="NewAppBox" Style="{StaticResource Input}"
                                         Tag="Process name (no .exe)" KeyDown="OnNewAppKeyDown" />
                                <Button Grid.Column="1" Style="{StaticResource Btn}" Content="Add"
                                        Margin="8,0,0,0" Click="OnAddBlockedApp" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ======================== ADVANCED ======================== -->
            <ScrollViewer x:Name="AdvancedPane" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Margin="28,22,28,28" MaxWidth="660" HorizontalAlignment="Left">
                    <TextBlock Style="{StaticResource CardHeader}" Text="Debounce" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Style="{StaticResource SettingRow}">
                                <TextBlock Style="{StaticResource RowLabel}" Text="Trigger Debounce" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Slider x:Name="DebounceSlider" Style="{StaticResource ModernSlider}"
                                            Width="200" Minimum="20" Maximum="300"
                                            SmallChange="10" LargeChange="20" TickFrequency="10"
                                            IsSnapToTickEnabled="True" ValueChanged="OnDebounceChanged" />
                                    <TextBlock x:Name="DebounceLabel" Style="{StaticResource Mono}"
                                               Width="56" TextAlignment="Right" VerticalAlignment="Center"
                                               Margin="8,0,0,0" Text="50 ms" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,4"
                                       Text="How long Cotabby waits after a keystroke before asking the model. Lower feels snappier; higher saves work while you type in bursts." />
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource CardHeader}" Text="Paths" />
                    <Border Style="{StaticResource Card}" Padding="14,6">
                        <StackPanel>
                            <Grid MinHeight="48">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Style="{StaticResource Caption}" Text="Settings" />
                                    <TextBlock x:Name="SettingsPathText" Style="{StaticResource Mono}"
                                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource Btn}" Content="Open"
                                        Click="OnOpenSettingsFile" />
                            </Grid>
                            <Border Style="{StaticResource RowSep}" />
                            <Grid MinHeight="48">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Style="{StaticResource Caption}" Text="Models" />
                                    <TextBlock x:Name="ModelsPathText" Style="{StaticResource Mono}"
                                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource Btn}" Content="Open"
                                        Click="OnOpenModelsFolder" />
                            </Grid>
                            <Border Style="{StaticResource RowSep}" />
                            <Grid MinHeight="48">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Style="{StaticResource Caption}" Text="Log" />
                                    <TextBlock x:Name="LogPathText" Style="{StaticResource Mono}"
                                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource Btn}" Content="Open"
                                        Click="OnOpenLog" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ========================= ABOUT ========================= -->
            <ScrollViewer x:Name="AboutPane" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Margin="28,22,28,28" MaxWidth="660" HorizontalAlignment="Left">
                    <Border Style="{StaticResource Card}" Padding="18">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="AboutLogo" Width="40" Height="40" CornerRadius="9"
                                        Background="{StaticResource AccentBrush}">
                                    <TextBlock x:Name="AboutLogoFallback" Text="🐱"
                                               FontFamily="Segoe UI Emoji" FontSize="19"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Cotabby" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource Caption}"
                                               Text="Local Windows AI Autocomplete" />
                                </StackPanel>
                            </StackPanel>
                            <TextBlock x:Name="VersionText" Style="{StaticResource Caption}"
                                       Margin="0,14,0,0" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0"
                                       Text="Windows port of the open-source macOS app." />
                            <TextBlock Margin="0,8,0,0" FontSize="12">
                                <Hyperlink NavigateUri="https://github.com/FuJacob/cotabby"
                                           RequestNavigate="OnOpenLink"
                                           Foreground="{StaticResource AccentBrush}"
                                           TextDecorations="None">GitHub Repository</Hyperlink>
                            </TextBlock>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0"
                                       Text="GNU AGPL v3.0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
