<Window x:Class="Cotabby.App.Emoji.EmojiPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        IsHitTestVisible="False"
        ResizeMode="NoResize">
    <!-- Dark HUD chrome with the typed query row above a horizontal ribbon of ranked glyphs. -->
    <Border CornerRadius="10" BorderBrush="#1FFFFFFF" BorderThickness="1">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FF2B2B2B" Offset="0" />
                <GradientStop Color="#FF1C1C1C" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>
        <StackPanel>
            <StackPanel x:Name="QueryRow" Orientation="Horizontal"
                        TextElement.FontFamily="Cascadia Mono, Consolas"
                        TextElement.FontSize="12" TextElement.FontWeight="Medium">
                <TextBlock Text=":" Foreground="#80FFFFFF" VerticalAlignment="Center" />
                <TextBlock x:Name="QueryText" Foreground="#F2FFFFFF" VerticalAlignment="Center" />
            </StackPanel>
            <Grid x:Name="RibbonRow">
                <ScrollViewer x:Name="Ribbon"
                              HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="Cells" Orientation="Horizontal" VerticalAlignment="Center" />
                </ScrollViewer>
                <TextBlock x:Name="EmptyLabel" Text="No emoji" FontFamily="Segoe UI" FontSize="12"
                           Foreground="#80FFFFFF" VerticalAlignment="Center" />
            </Grid>
        </StackPanel>
    </Border>
</Window>
